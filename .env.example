# Firebase public web config (safe to expose to the browser).
# From Firebase console → Project settings → Your apps → Web app → SDK config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server secret used to sign our HttpOnly session JWT (HS256).
# Must be >= 32 bytes. Generate one with:  openssl rand -base64 48
SESSION_JWT_SECRET=

# Public base URL for absolute metadata / Open Graph links.
# Optional — defaults to http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=

# Supabase (Project Settings → API). URL + anon key are public (browser-safe);
# the service_role key is a SECRET — server-only, never expose to the client.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
